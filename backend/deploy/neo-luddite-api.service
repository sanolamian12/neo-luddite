# systemd unit — Seam A FastAPI (always-on).
# 설치: sudo cp neo-luddite-api.service /etc/systemd/system/
#       sudo systemctl daemon-reload && sudo systemctl enable --now neo-luddite-api
# 로그: journalctl -u neo-luddite-api -f
#
# always-on 이 중요한 이유(메모리 project_deployment_plan): 백엔드가 죽어 있으면
# 검수 최종승인 시 RAG 적재가 조용히 skip 된다 → 재시작 정책으로 상시 가동 보장.

[Unit]
Description=Neo-Luddite Seam A FastAPI (/api/chat + RAG)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/neo-luddite/backend
# .venv 안의 uvicorn 을 절대경로로.
#
# ⚠️ --workers 는 1 을 유지할 것. 박스를 키워도 늘리면 안 된다.
#   근거(10/16 갱신): ① api/upstage_gate.py 는 프로세스 안 FIFO 게이트라 워커 수만큼 Upstage
#   동시 호출 상한 k 가 곱해진다(P7 C: 동시 호출이 몰리면 일부가 멈춘다) ② api/rag/vec_memory.py 가
#   워커마다 KB3·법령 벡터를 메모리에 따로 올린다. (원래 근거였던 kb2 재구조화 job 리퍼는 옛 검수
#   흐름 절단 S3(10/16)에서 KB2 와 함께 지웠다.)
#   워커 증설은 게이트를 프로세스 밖으로 빼는 선행 작업이 끝난 뒤의 별도 과제다.
#
# FastAPI 가 async 라 LLM 호출 같은 I/O 대기는 워커 1개로도 겹쳐 처리된다 —
# 동시성 천장은 대개 CPU 가 아니라 Upstage 레이트리밋 쪽이다(같은 문서 §5-2).
ExecStart=/opt/neo-luddite/backend/.venv/bin/uvicorn api.main:app --host 127.0.0.1 --port 8787 --workers 1
Restart=always
RestartSec=3
# 환경은 backend/.env 를 앱(load_dotenv)이 직접 읽음. 여기선 최소만.
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
