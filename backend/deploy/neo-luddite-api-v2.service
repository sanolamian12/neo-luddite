# systemd unit — Seam A **v2** (브랜치 agentic-v2, LLM1 역할 축소). 기본 **꺼짐**.
# 설계: design/LLM1v2_역할축소_구현설계.md §5 단계 0.5 · docs/doing/v2격리_원복설계.md §1(프로세스 층)
#
# 설치(단계 0.5 — 파일만 두고 enable 하지 않는다):
#   sudo cp neo-luddite-api-v2.service /etc/systemd/system/ && sudo systemctl daemon-reload
# 켜기(단계 5):   sudo systemctl enable --now neo-luddite-api-v2
# 끄기(원복 2단계): sudo systemctl disable --now neo-luddite-api-v2
#   → Caddy 가 `/api/chat?pipeline=v2` 를 v1(8787)로 흘린다(Caddyfile 의 lb_policy first). 프론트 영향 없음.
#
# 코드: /opt/neo-luddite-v2 = /opt/neo-luddite 의 git worktree(브랜치 agentic-v2). 서버 deploy.sh 는
#       import-credigraph 만 만지므로 v2 코드는 이 worktree 를 손으로 pull 해야 바뀐다.
# .env: /opt/neo-luddite-v2/backend/.env → v1 의 .env 심볼릭 링크(비밀값 원본 하나).
# venv: v2 전용(.venv, requirements-api.lock.txt) — v2 의존성 변경이 v1 에 번지지 않게.

[Unit]
Description=Neo-Luddite Seam A v2 (agentic-v2 — /api/chat?pipeline=v2 only)
After=network-online.target neo-luddite-api.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/neo-luddite-v2/backend
ExecStart=/opt/neo-luddite-v2/backend/.venv/bin/uvicorn api.main:app --host 127.0.0.1 --port 8788 --workers 1
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1
# ⚠️ 지우지 말 것. 이 프로세스가 kb2 폴러를 띄우면 기동 직후 리퍼(kb2_store.py:781)가
#   같은 DB 의 running job 을 전부 error 처리한다 = v1 이 돌리는 job 을 죽인다.
#   (v1 유닛의 --workers 1 주석과 같은 이유. 유닛 파일 Environment 는 .env 보다 우선한다.)
Environment=BACKGROUND_JOBS=off
# Upstage 동시호출 게이트는 프로세스 안의 줄이라 두 프로세스가 한 줄을 공유하지 못한다.
# v1 k=3 + v2 k=1 = 합계 상한 4. (설계는 "같은 줄"을 원했다 — 프로세스를 가른 대가.)
Environment=UPSTAGE_MAX_CONCURRENCY=1

[Install]
WantedBy=multi-user.target
