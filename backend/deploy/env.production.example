# ── Seam A 백엔드 프로덕션 env (Oracle 도쿄 ap-tokyo-1) ────────────────────
# 이 파일을 서버의  /opt/neo-luddite/backend/.env  로 복사해 값을 채운다.
# main.py 가 backend/.env 를 load_dotenv 로 읽는다. gitignore — 절대 커밋 금지.
#
# ⚠️ 새로 만들기보다 **구 서버에서 회수**하는 쪽이 안전하다. 실제로 2026-09-24 이전 때
#    서버 실물(9/18 수정)과 로컬 사본(7/27)이 2개월 어긋나 있었다:
#        scp -i <키> ubuntu@<구서버>:/opt/neo-luddite/backend/.env ./
#    이 템플릿은 회수할 원본이 없을 때(재해복구)의 최소 뼈대다.

# ── Upstage (국산 · 필수) ───────────────────────────────────────────────
UPSTAGE_API_KEY=            # ⚠️ 필수. 로컬 backend/.env 값 그대로.
UPSTAGE_BASE_URL=https://api.upstage.ai/v1
UPSTAGE_CHAT_MODEL=solar-pro3
# 임베딩(기본값 있으면 생략 가능) — 로컬과 동일하게 맞출 것
UPSTAGE_EMBED_QUERY_MODEL=embedding-query
UPSTAGE_EMBED_PASSAGE_MODEL=embedding-passage

# ── Supabase ────────────────────────────────────────────────────────────
# ① 프로젝트 URL — **쓰기 API 토큰 검증(JWKS)에 쓰인다**(api/auth.py:68).
#    AUTH_MODE=required 인데 이게 비어 있으면 쓰기 요청이 전부 503 으로 떨어진다.
SUPABASE_URL=https://hvnvxfakdhhbakdjkxos.supabase.co

# ② Postgres 직결 (RAG 저장/검색 · 필수)
#    Supabase 대시보드 → Project Settings → Database → Connection string.
#    ⚠️ Session/Transaction "풀러(pooler)" 문자열을 쓸 것(직결보다 안정적).
#       비밀번호에 특수문자가 있으면 URL 그대로 두고 SUPABASE_DB_PASSWORD 로 따로 준다
#       ([YOUR-PASSWORD] placeholder 자동 치환).
SUPABASE_DB_URL=postgresql://postgres.hvnvxfakdhhbakdjkxos:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres
SUPABASE_DB_PASSWORD=       # DB 비밀번호 raw (특수문자 인코딩 신경 안 써도 됨)

# ⚠️ SUPABASE_SERVICE_ROLE_KEY 는 **넣지 말 것.**
#    프로덕션 .env 에 남아 있지만 리포 어디에서도 읽지 않는다(2026-09-27 전수 확인).
#    RLS 를 우회하는 전권 키라, 쓰지도 않으면서 서버에 두면 유출 반경만 넓어진다.

# ── CORS (프론트 Vercel 도메인 · 필수) ──────────────────────────────────
# 프론트 도메인 기준이라 **백엔드 박스를 옮겨도 바뀌지 않는다**(2026-09-24 이전 때 확인).
# 콤마로 여러 개 가능(로컬 개발 병행 시).
CORS_ORIGINS=https://neo-luddite.vercel.app

# ── 쓰기 API 인증 (P6 거버넌스 · 프로덕션은 required) ────────────────────
# optional(기본) | required. 프로덕션은 required 여야 한다 — 아니면 세무사 사례·공용 KB 승인 쓰기 API가
# 토큰 없이 열린다. 스크립트에서 토큰을 만들 때는 scripts.dev_token 을 쓴다.
AUTH_MODE=required

# ── RAG ─────────────────────────────────────────────────────────────────
RAG_ENABLED=true     # DB app_config.rag_enabled 가 있으면 그쪽이 우선(0 이면 KB3 검색까지 막힌다)
# RAG_TOP_K=5

# 근거 검색은 KB3 하나다(판례·심판례·질의회신·세무사 사례 — 2026-10-06 운영 결정, 옛 검수 흐름 절단 S5 에서
# rag·kb2·hybrid·fusion·v2·kbdict 갈래를 코드에서 지움). RAG_SOURCE·RAG_MIN_SCORE·KB2_MIN_SCORE·KBDICT_MIN_SCORE·
# FUSION_QUOTA_* 는 더 이상 읽지 않는다 — 서버 .env 에 남아 있으면 지운다.
# kb3 임계는 코드에 기본값이 있어 보통 건드리지 않는다. 바꿀 때만 주석 해제:
#   KB3_MIN_SCORE=0.40

# ── LLM3 관련 법령 선택 (design/LLM3_법령DB_설계.md, 2026-10-08) ──────────────────
# laws.articles(0046) 현행 조문 → 질문에 맞는 조문을 골라 원문을 작문에 동봉 + 작문 뒤 인용 대조.
# 끄면(off) 10/7 이전 동작 그대로. LAW_ONLY=on 은 사례 근거 0건일 때 조문만으로 일반 안내(outcome law_advisory).
LAW_SELECT=on
LAW_ONLY=on
# LAW_CITE_CHECK=drop    # off 면 허용 밖 법령 인용 문장을 빼지 않는다(로그만)
# LAW_STORE=db           # file = backend/data/laws/ (오프라인 하네스용, 서버엔 파일 없음)
