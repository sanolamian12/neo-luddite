{"case_id": "nts_taxlaw_대법원-2012-두-20533", "source": "nts_taxlaw", "source_url": "https://taxlaw.nts.go.kr/qt/USEQTA002P.do?ntstDcmId=000000000000157776", "case_number": "대법원-2012-두-20533", "title": "(심리불속행) 연말정산에 의하여 소득세를 납부하였므로 무신고로 볼 수 없어 5년의 제척기간을 적용하여야 함", "tax_category": "소득세·법인전환·개원폐업", "law_articles": [], "decision_date": "2012-12-28", "decision_type": null, "agency": "대법원", "summary": "(원심 요지) 2인 이상으로부터 받는 근로소득이 있는 자로서 연말정산에 의하여 소득세를 납부한 자에 해당하므로 종합소득세 과세표준 확정신고를 할 의무가 있다고 할 수는 없어, 원천징수 신고 누락한 주식매수 선택권 행사이익 소득세 부과 제척기간은 5년으로 보아야 함", "full_text": "", "inquiry_agency": null, "tags": [], "collected_at": "2026-09-25T13:59:13", "ntst_dcm_id": "000000000000157776", "prec_seq": "289624", "tax_law": "소득세", "tax_law_code": "305", "attr_year": "2004", "lower_case_number": "서울고등법원-2012-누-4717", "keywords": ["연말정산"], "keyword": "연말정산", "gist_keyword_hit": true, "near_dup_of": null}
{"case_id": "nts_taxlaw_서울고등법원-2025-누-8716", "source": "nts_taxlaw", "source_url": "https://taxlaw.nts.go.kr/qt/USEQTA002P.do?ntstDcmId=200000000000022812", "case_number": "서울고등법원-2025-누-8716", "title": "이 사건 과세전적부심사청구권의 박탈여부 및 1세대 1주택 비과세 특례 적용 여부", "tax_category": "소득세·법인전환·개원폐업", "law_articles": ["소득세법 시행령 제154조"], "decision_date": "2026-07-10", "decision_type": null, "agency": "서울고등법원", "summary": "과세관청인 피고의 귀책사유 없이 부득이한 사정으로 이 사건 양도소득세 부과제척기간의 만료일이 매우 임박하게 되었고, 이로 인하여 피고에게 이 사건 처분에 앞서 과세예고통지를 할 시간적 여유가 거의 없었으며, 이 사건 처분 전에 과세예고통지가 이루어졌다고 하더라도 원고들이 누릴 절차적 이익은 거의 없어, 이 사건 처분 전에 원고들에 대하여 과세예고통지가 이루어지지 않음으로 인하여 과세처분 과정에서의 절차적 정당성이 상실되지 않았다고 볼 만한 특별한 사정이 있다고 인정할 수 있으므로, 이 사건 처분이 앞서 본 바와 같이 과세예고통지 전에 이루어졌다고 하더라도 그로 인하여 이 사건 처분이 위법하다고 평가하기는 어려움 실체적 하자에 대한 판단 – 양도일까지 4층은 주택으로 사용하였으므로 1세대 1주택 비과세특례 요건을 충족하지 않아 과세처분은 적법", "full_text": "", "inquiry_agency": null, "tags": ["1세대1주택 비과세특례", "전자고지", "과세전적부심사기회 박탈"], "collected_at": "2026-09-25T13:59:23", "ntst_dcm_id": "200000000000022812", "prec_seq": "623805", "tax_law": "소득세", "tax_law_code": "307", "attr_year": "2017", "lower_case_number": "서울행정법원2024구단55313", "keywords": ["1세대 1주택 비과세"], "keyword": "1세대 1주택 비과세", "gist_keyword_hit": true, "near_dup_of": null}
{"case_id": "nts_taxlaw_수원지방법원-2025-구단-10877", "source": "nts_taxlaw", "source_url": "https://taxlaw.nts.go.kr/qt/USEQTA002P.do?ntstDcmId=200000000000022537", "case_number": "수원지방법원-2025-구단-10877", "title": "일시적 2주택자에 대한 1세대 1주택 비과세 특례 적용", "tax_category": "소득세·법인전환·개원폐업", "law_articles": ["소득세법 제89조", "소득세법 시행령 제155조"], "decision_date": "2026-06-24", "decision_type": null, "agency": "수원지방법원", "summary": "구 소득세법 시행령 제155조 제1항 2호 가목은 법률의 위임 법위를 벗어나 명확성의 원칙이나 조세법률주의에 위배되었다고 볼 수 없으며, 일시적 2주택 비과세 특례 요건(신규주택 취득일로부터 1년 이내에 세대전원이 이사하고 전입신고할 것)을 충족하지도 않음", "full_text": "", "inquiry_agency": null, "tags": ["#일시적 2주택자에 대한 1세대 1주택 비과세 특례"], "collected_at": "2026-09-25T13:59:26", "ntst_dcm_id": "200000000000022537", "prec_seq": "622743", "tax_law": "소득세", "tax_law_code": "307", "attr_year": "2021", "lower_case_number": null, "keywords": ["1세대 1주택 비과세"], "keyword": "1세대 1주택 비과세", "gist_keyword_hit": true, "near_dup_of": null}
