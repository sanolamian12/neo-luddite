      "refersTo": "auditor-navigation-active",
      "description": "An active row in the existing auditor role theme.",
      "html": "<nav class=\"ds-auditor-nav\" aria-label=\"전문가 메뉴\"><a class=\"ds-auditor-link\" href=\"#agents\" aria-current=\"page\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect width=\"8\" height=\"8\" x=\"3\" y=\"3\" rx=\"2\"/><path d=\"M7 11v4a2 2 0 0 0 2 2h4\"/><rect width=\"8\" height=\"8\" x=\"13\" y=\"13\" rx=\"2\"/></svg><span>내 에이전트</span></a></nav>",
      "css": ".ds-auditor-nav{--sidebar:oklch(0.33 0.06 165);--sidebar-foreground:oklch(0.97 0.02 165);--sidebar-accent:oklch(0.42 0.08 165);--sidebar-accent-foreground:oklch(0.98 0.02 165);padding:8px;background:var(--sidebar);color:var(--sidebar-foreground);}.ds-auditor-link{display:flex;align-items:center;gap:8px;height:32px;padding:8px;border-radius:calc(var(--radius,0.625rem)*.8);color:var(--sidebar-foreground);text-decoration:none;font:400 14px/20px var(--font-sans,sans-serif);}.ds-auditor-link:hover,.ds-auditor-link:active,.ds-auditor-link[aria-current=page]{background:var(--sidebar-accent);color:var(--sidebar-accent-foreground);}.ds-auditor-link[aria-current=page]{font-weight:500;}.ds-auditor-link:focus-visible{outline:none;box-shadow:0 0 0 2px var(--brand-green,oklch(0.8 0.15 162));}"
    },
