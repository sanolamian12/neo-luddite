  "components": [
    {
      "name": "Shared primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Existing shared action; retains the application blue.",
      "html": "<button class=\"ds-primary\" type=\"button\">저장</button>",
      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:center;height:32px;padding:0 10px;gap:6px;border:1px solid transparent;border-radius:var(--radius,0.625rem);font:500 14px/20px var(--font-sans,sans-serif);white-space:nowrap;cursor:pointer;transition:all .15s;background:var(--primary,oklch(0.54 0.13 238));color:var(--primary-foreground,oklch(0.985 0 0));}.ds-primary:hover{background:color-mix(in oklch,var(--primary,oklch(0.54 0.13 238)) 80%,transparent);}.ds-primary:focus-visible{outline:none;border-color:var(--ring,oklch(0.54 0.13 238));box-shadow:0 0 0 3px color-mix(in oklch,var(--ring,oklch(0.54 0.13 238)) 50%,transparent);}.ds-primary:active{transform:translateY(1px);}.ds-primary:disabled{pointer-events:none;opacity:.5;}"
    },
    {
      "name": "Shared outline button",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "Existing bordered action on the shared working surface.",
      "html": "<button class=\"ds-outline\" type=\"button\">취소</button>",
      "css": ".ds-outline{display:inline-flex;align-items:center;justify-content:center;height:32px;padding:0 10px;gap:6px;border:1px solid transparent;border-radius:var(--radius,0.625rem);font:500 14px/20px var(--font-sans,sans-serif);white-space:nowrap;cursor:pointer;transition:all .15s;background:var(--background,white);color:var(--foreground,oklch(0.145 0 0));border-color:var(--border,oklch(0.922 0 0));}.ds-outline:hover{background:var(--muted,oklch(0.97 0 0));}.ds-outline:focus-visible{outline:none;border-color:var(--ring,oklch(0.54 0.13 238));box-shadow:0 0 0 3px color-mix(in oklch,var(--ring,oklch(0.54 0.13 238)) 50%,transparent);}.ds-outline:active{transform:translateY(1px);}.ds-outline:disabled{pointer-events:none;opacity:.5;}"
    },
    {
      "name": "Shared input",
      "kind": "input",
      "refersTo": "input",
      "description": "The existing compact field with shared theme focus and invalid states.",
      "html": "<input class=\"ds-input\" aria-label=\"이름\" placeholder=\"이름을 입력하세요\" />",
      "css": ".ds-input{height:32px;width:100%;min-width:0;border:1px solid var(--input,oklch(0.922 0 0));border-radius:var(--radius,0.625rem);background:transparent;color:var(--foreground,oklch(0.145 0 0));padding:4px 10px;font:400 16px/24px var(--font-sans,sans-serif);transition:color .15s,background-color .15s,border-color .15s;}.ds-input::placeholder{color:var(--muted-foreground,oklch(0.556 0 0));}.ds-input:focus-visible{outline:none;border-color:var(--ring,oklch(0.54 0.13 238));box-shadow:0 0 0 3px color-mix(in oklch,var(--ring,oklch(0.54 0.13 238)) 50%,transparent);}.ds-input[aria-invalid=true]{border-color:var(--destructive,oklch(0.577 0.245 27.325));box-shadow:0 0 0 3px color-mix(in oklch,var(--destructive,oklch(0.577 0.245 27.325)) 20%,transparent);}.ds-input:disabled{cursor:not-allowed;opacity:.5;background:color-mix(in oklch,var(--input,oklch(0.922 0 0)) 50%,transparent);}@media(min-width:768px){.ds-input{font-size:14px;line-height:20px;}}"
    },
    {
      "name": "Shared card",
      "kind": "card",
      "refersTo": "card",
      "description": "The shared rounded container; the outline ring carries its boundary.",
      "html": "<article class=\"ds-card\"><div class=\"ds-card-title\">상담 평가</div><p class=\"ds-card-description\">확인할 상담과 평가 내용을 살펴보세요.</p></article>",
      "css": ".ds-card{display:flex;flex-direction:column;gap:16px;overflow:hidden;border-radius:calc(var(--radius,0.625rem)*1.4);background:var(--card,white);color:var(--card-foreground,oklch(0.145 0 0));padding:16px;font:400 14px/20px var(--font-sans,sans-serif);box-shadow:0 0 0 1px color-mix(in oklch,var(--foreground,oklch(0.145 0 0)) 10%,transparent);}.ds-card-title{font-size:16px;font-weight:500;line-height:1.375;}.ds-card-description{margin:0;color:var(--muted-foreground,oklch(0.556 0 0));}"
    },
    {
      "name": "Shared badge",
      "kind": "chip",
      "refersTo": "badge",
      "description": "Existing primary status label; a noninteractive span.",
      "html": "<span class=\"ds-badge\">진행중</span>",
      "css": ".ds-badge{display:inline-flex;align-items:center;justify-content:center;width:fit-content;height:20px;padding:2px 8px;border:1px solid transparent;border-radius:calc(var(--radius,0.625rem)*2.6);background:var(--primary,oklch(0.54 0.13 238));color:var(--primary-foreground,oklch(0.985 0 0));font:500 12px/16px var(--font-sans,sans-serif);white-space:nowrap;}"
    },
    {
