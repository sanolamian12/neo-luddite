# 프론트 환경변수 (마스터설계 §3-2). frontend/.env.local 로 복사해 채운다.
# 실제 .env.local 은 gitignore — 커밋 금지.

# Supabase (브라우저는 anon key + RLS)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Seam A Python 백엔드 (하이브리드 챗) 접점 — C 가 배포 후 확정
NEXT_PUBLIC_API_BASE=http://localhost:8000

# 데이터 모드 — 미지정이면 프로토타입(샘플 데이터·백엔드 미연결)이 기본값이다.
# 프로덕션(Vercel)과 실제 서버 연결 로컬 개발은 반드시 live. 빌드 시점에 박히므로 바꾸면 재빌드.
NEXT_PUBLIC_DATA_MODE=live
# 챗 기본 모드(옛 챗 화면용). 프로덕션은 remote.
NEXT_PUBLIC_CHAT_MODE=remote

# Supabase 대시보드에서 활성화한 공급자만 표시한다(쉼표 구분).
# OAuth Client Secret 은 Supabase 공급자 설정에만 보관한다.
NEXT_PUBLIC_AUTH_PROVIDERS=google,kakao
# 신규 프로젝트의 publishable key 도 지원한다(있으면 ANON_KEY 보다 우선).
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# 가입 전 DB migration 0047 적용 및 콜백 URL 설정: design/supabase-auth.md
